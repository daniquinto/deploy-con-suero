# ─── Cliente de Open Payments ────────────────────────────────────────────────
# Wallet address del CLIENTE (tu software): la que firma las peticiones.
# Formato https://, sin "$" y sin barra final.
OP_CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/client

# Key ID de la llave registrada en esa wallet address (test wallet:
# Settings -> Developer Keys -> expandir la llave generada).
OP_KEY_ID=

# Llave privada Ed25519 (PEM PKCS#8). Ruta a archivo; en Docker, un secreto montado :ro.
OP_PRIVATE_KEY_PATH=./private.key
# Alternativa si no puedes montar archivos: el PEM en base64.
# OP_PRIVATE_KEY_B64=

# ─── Wallets del flujo ───────────────────────────────────────────────────────
OP_SENDER_WALLET_ADDRESS=https://ilp.interledger-test.dev/alice
OP_RECEIVER_WALLET_ADDRESS=https://ilp.interledger-test.dev/bob

# Monto entero en la escala del activo. 1000 con assetScale 2 = 10,00
OP_AMOUNT=1000

# ─── Backend HTTP (skill open-payments-backend-api) ──────────────────────────
# Base pública https de ESTE backend: es la que recibe el redirect del
# authorization server tras el consentimiento. No puede ser localhost ni http.
PUBLIC_BASE_URL=https://api.tu-dominio.com
# A dónde se manda al usuario al terminar.
FRONTEND_URL=https://tu-dominio.com
PORT=3000
# Secreto para cifrar access tokens en reposo. En producción: KMS o secreto gestionado.
TOKEN_ENC_SECRET=

# ─── Suscripciones (skill open-payments-recurring) ───────────────────────────
SUB_AMOUNT=500
SUB_CAP=600
# ISO 8601 repetido: R<n>/<inicio>/<duración>
# SUB_INTERVAL=R12/2026-01-01T00:00:00Z/P1M
