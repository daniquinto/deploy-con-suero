# ============================================================================
#  deploy-con-suero — backend · configuración de Open Payments
# ============================================================================
#  Este archivo contiene SECRETOS. Ya está en .gitignore y en .dockerignore:
#  nunca lo commitees ni lo hornees en la imagen Docker.
#
#  Las credenciales de desarrollo se obtienen en https://wallet.interledger-test.dev
#  (Settings -> Developer Keys). Rellena todo lo marcado como [RELLENAR].
#
#  Verifica la configuración antes de programar el flujo de pago:
#      npm install && npm run op:check
# ============================================================================


# ─── 1. Cliente de Open Payments (lo que firma cada petición) ────────────────
# Wallet address del CLIENTE, es decir de ESTA aplicación; no la del donante ni
# la del comercio. Formato https://, sin "$" y sin barra final.
OP_CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/deploy-con-suero

# Key ID de la llave Ed25519 registrada en esa wallet address.
# Test wallet: Settings -> Developer Keys -> expandir la llave generada.
# [RELLENAR] Sin esto, toda petición firmada devuelve 401.
OP_KEY_ID=

# Llave privada Ed25519 en PEM PKCS#8 (-----BEGIN PRIVATE KEY-----).
# Elige UNA de las tres formas; se evalúan en este orden de prioridad.
#
# a) Ruta a archivo (recomendado; en Docker, un secreto montado :ro).
OP_PRIVATE_KEY_PATH=./secrets/private.key
# b) El PEM completo en base64, si no puedes montar archivos:
#      base64 -w0 private.key
# OP_PRIVATE_KEY_B64=
# c) El PEM en una sola línea con "\n" literales en vez de saltos de línea:
# OP_PRIVATE_KEY=


# ─── 2. Wallets del proyecto ─────────────────────────────────────────────────
# Wallet address del FONDO de la plataforma: recibe las donaciones (incoming
# payments) y es la que paga a los comercios (outgoing payments).
# [RELLENAR]
OP_FUND_WALLET_ADDRESS=https://ilp.interledger-test.dev/fondo-emergencia

# Wallets de prueba para el flujo end-to-end en desarrollo.
# En producción el donante llega desde el frontend y el comercio desde la base
# de datos: estas dos variables son solo para probar sin interfaz.
OP_TEST_DONOR_WALLET_ADDRESS=https://ilp.interledger-test.dev/donante
OP_TEST_MERCHANT_WALLET_ADDRESS=https://ilp.interledger-test.dev/comercio

# Monto por defecto, entero en la escala del activo (1000 con assetScale 2 = 10,00).
OP_DEFAULT_AMOUNT=1000


# ─── 3. Grants interactivos (consentimiento del donante) ─────────────────────
# Base pública https de ESTE backend: recibe el redirect del authorization
# server tras el consentimiento. No puede ser localhost ni http en producción.
# [RELLENAR]
PUBLIC_BASE_URL=https://api.tu-dominio.com
# A dónde se manda al donante al terminar.
FRONTEND_URL=https://tu-dominio.com
# Ruta (relativa a PUBLIC_BASE_URL) que recibe el interact_ref del AS.
OP_INTERACT_FINISH_PATH=/op/callback


# ─── 4. Opciones del SDK ─────────────────────────────────────────────────────
# Valida las respuestas contra el spec OpenAPI. true en dev, false en producción.
OP_VALIDATE_RESPONSES=true
# Timeout por petición en ms. Súbelo si el proveedor va lento.
OP_REQUEST_TIMEOUT_MS=10000
# silent | error | warn | info | debug
OP_LOG_LEVEL=info
# SOLO true para un Rafiki local servido por http://
OP_USE_HTTP=false
# Segundos que se cachea una wallet address resuelta (0 desactiva la caché).
OP_WALLET_CACHE_TTL_SECONDS=300


# ─── 5. Servidor HTTP ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Secreto para cifrar los access tokens en reposo (32+ bytes aleatorios):
#      openssl rand -base64 32
# [RELLENAR]
TOKEN_ENC_SECRET=


# ─── 6. API propia: base de datos y sesiones ─────────────────────────────────
# PostgreSQL de la VPS. Formato: postgres://USUARIO:CLAVE@HOST:PUERTO/BASE
# Si la clave tiene caracteres especiales (@ : / #) van codificados (%40, %3A…).
# [RELLENAR]
DATABASE_URL=
# true si el servidor de Postgres exige TLS.
DATABASE_SSL=false
# Aplica las migraciones pendientes (src/db/migrations) al arrancar.
AUTO_MIGRATE=true

# Firma de los tokens de sesión (JWT). 32+ caracteres aleatorios:
#      openssl rand -base64 32
# [RELLENAR]
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Regla de negocio: la fundación nace PENDIENTE y una entidad la activa.
# Mientras no exista ese flujo, true la deja ACTIVA al registrarse.
AUTO_ACTIVATE_FOUNDATIONS=true

# Orígenes del frontend que pueden llamar a la API, separados por coma.
CORS_ORIGINS=http://localhost:5173
